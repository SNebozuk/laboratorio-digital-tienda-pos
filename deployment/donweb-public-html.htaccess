Options -Indexes
DirectoryIndex index.php

# Los nombres de CSS y JavaScript llevan una versión en la URL. Se pueden
# guardar de forma segura en el navegador y así las visitas posteriores no
# vuelven a descargar la interfaz completa.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|svg|woff2?|webp|png|jpe?g|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Reduce notablemente la descarga del catálogo JSON cuando Apache cuenta con
# mod_deflate (configuración habitual en hosting compartido).
<IfModule mod_filter.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^$ laboratorio-digital-git-20260730/index.php [L]

  RewriteRule ^tienda$ tienda/ [R=302,L]
  RewriteRule ^admin$ admin/ [R=302,L]

  RewriteRule ^tienda/assets/(.+)$ laboratorio-digital-git-20260730/v1/assets/$1 [L]
  RewriteRule ^tienda/uploads/products/(.+)$ laboratorio-digital-git-20260730/v1/uploads/products/$1 [L]
  RewriteRule ^tienda/admin/assets/(.+)$ laboratorio-digital-git-20260730/v1/admin/assets/$1 [L]
  RewriteRule ^tienda/payment\.php$ laboratorio-digital-git-20260730/v1/payment.php [L,QSA]
  RewriteRule ^tienda/?$ laboratorio-digital-git-20260730/v1/index.php [L,QSA]

  RewriteRule ^admin/receipt\.php$ laboratorio-digital-git-20260730/v1/admin/receipt.php [L,QSA]
  RewriteRule ^admin/?$ laboratorio-digital-git-20260730/v1/admin/index.php [L,QSA]

  RewriteRule ^api\.php$ laboratorio-digital-git-20260730/api.php [L,QSA]
</IfModule>
