!storage/.htaccess

# Comprobantes y archivos privados cargados por clientes
data/proofs/
data/comprobantes/
uploads/

# Dependencias y herramientas locales
vendor/
node_modules/
__pycache__/
*.py[cod]
.phpunit.result.cache

# Archivos de trabajo, registros y paquetes generados
work/
git-history/
outputs/*.zip
backups/
*.log
*.bak
*.tmp

# Editores y sistema operativo
.idea/
.vscode/
.DS_Store
Thumbs.db
