Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tienda$ tienda/ [R=302,L]
  RewriteRule ^admin$ admin/ [R=302,L]

  RewriteRule ^tienda/assets/(.+)$ v1/assets/$1 [L]
  RewriteRule ^tienda/uploads/products/(.+)$ v1/uploads/products/$1 [L]
  RewriteRule ^tienda/admin/assets/(.+)$ v1/admin/assets/$1 [L]
  RewriteRule ^tienda/payment\.php$ v1/payment.php [L,QSA]
  RewriteRule ^tienda/?$ v1/index.php [L,QSA]

  RewriteRule ^admin/receipt\.php$ v1/admin/receipt.php [L,QSA]
  RewriteRule ^admin/?$ v1/admin/index.php [L,QSA]
</IfModule>

<FilesMatch "^(config(?:\.mail)?\.local\.php|.*\.(sqlite|sqlite3|db))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
