Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tienda/?$ v1/index.php [L,QSA]
  RewriteRule ^admin/?$ v1/admin/index.php [L,QSA]
</IfModule>

<FilesMatch "^(config\.local\.php|.*\.(sqlite|sqlite3|db))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
